POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal_finances
POSTGRES_DB_TEST=personal_finances_test
POSTGRES_PORT=5432
POSTGRES_PORT_TEST=5433

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_finances"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/personal_finances_test"

# Auth.js — run `openssl rand -hex 32` for AUTH_SECRET.
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET come from a Google Cloud OAuth client
# (redirect URI: http://localhost:3000/api/auth/callback/google in local dev).
AUTH_SECRET=change-me-run-openssl-rand-hex-32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=change-me.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=change-me

